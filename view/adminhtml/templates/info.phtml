<?php /** @var $block \FreireH\CatalogRuleGrid\Block\Adminhtml\Info */ ?>

<?php
$catalogRule = $block->getCatalogRule();
$groupIds = $catalogRule->getCustomerGroupIds();
?>

<div class="admin__fieldset catalog-rule-info">
    <?php if ($groupIds !== null && is_array($groupIds)): ?>
        <section class="admin__field-section">
            <div class="admin__field admin__field-complex">
                <label class="admin__field-label">
                    <strong><?= __('Customer Groups') ?></strong>
                </label>
                <div class="admin__field-control">
                    <?php foreach ($groupIds as $groupId): ?>
                        <div class="group-item">
                            <?= $block->escapeHtml($block->getGroupName($groupId)) ?>
                        </div>
                    <?php endforeach; ?>
                </div>
            </div>
        </section>

        <section class="admin__field-section">
            <div class="admin__field admin__field-complex">
                <label class="admin__field-label">
                    <strong><?= __('Conditions') ?></strong>
                </label>
                <div class="admin__field-control">
                    <div class="admin__control-value">
                        <?= $block->getTextCondition() ?>
                    </div>
                </div>
            </div>
        </section>
    <?php else: ?>
        <div class="message message-notice">
            <?= __('No customer groups available.') ?>
        </div>
    <?php endif; ?>
</div>
